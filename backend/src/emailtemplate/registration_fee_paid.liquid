<!DOCTYPE html>
<html>
    <head>
        <style>
            table, th, td {
                border: 1px solid black;
                border-collapse: collapse;
                text-align: left;
            }
        </style>
    </head>
    <body>

        Dear {{ApplicantName}},<br/>
        <br/>
        Thank you for payment by {{PaymentMethod}} to The Hong Kong Polytechnic University via our Online Payment Platform.
        <br/>
        <br/>
        Payment Details:<br/>
        {{EventTitle}}<br/>
        PolyU Reference No.: {{RefNo}}<br/>
        Transaction ID: {{TransactionId}}<br/>
        Transaction Date and Time: {{PaymentDate}}<br/>
        Department Reference: {{DeptRef}}<br/>
        <br/>
        <table>
            <tr>
                <th style="width: 80">
                    <b>Item ID</b>
                </th>
                <th style="width: 250">
                    <b>Item Name</b>
                </th>
                <th style="text-align: right; width: 110">
                    <b>Quantity</b>
                </th>
                <th style="text-align: right; width: 110">
                    <b>Unit Price HK$</b>
                </th>
                <th style="text-align: right; width: 110">
                    <b>HK$</b>
                </th>
            </tr>
            {% for Item in Items %}
                <tr>
                    <td>
                        {{Item.ID}}
                    </td>
                    <td>
                        {{Item.Name}}
                    </td>
                    <td style="text-align: right">
                        {{Item.Quantity}}
                    </td>
                    <td style="text-align: right">
                        {{Item.Price}}
                    </td>
                    <td style="text-align: right">
                        {{Item.TotalPrice}}
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td colspan="4">
                    <b>Total</b>
                </td>
                <td style="text-align: right">
                    <b>HK${{PaymentAmount}}</b>
                </td>
            </tr>
        </table>
        {% if haveEarlyBird %}
            * at Early Bird rate
        {% endif %}
        <br/>
        <br/>
         This email serves as a receipt for the payment. Please retain this email as proof of payment if necessary. 
        <br/>
        <br/>
        {% if EventId == EventIdException %}
            For any enquiries, please send an email to asccs2024@polyu.edu.hk.
        {% elsif ContactPhoneNo == "" %}
            For any enquiries, please send an email to {{ContactEmail}}.
        {% else %}
            If you have any questions, please contact {{ContactName}} of {{ContactDept}} at{{ContactPhoneNo}} Email {{ContactEmail}}.
        {% endif %}
        <br/>
        <br/>
        Thank you for your attention.
        <br/>
        <br/>
        Regards,<br/>
        Finance Office<br/>
        The Hong Kong Polytechnic University
        <br/>
        <br/>
        (This is an auto-generated email. Please do not reply.)

    </body>
</html>